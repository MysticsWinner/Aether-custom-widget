<Page
    x:Class="CustomWidget.Dashboard.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20">

            <!-- ══════ Header Bar ══════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Security &amp; Plugin Sandbox Visualizer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <Border Background="{StaticResource AetherSuccessBrush}" Opacity="0.2" CornerRadius="10" Padding="8,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ AppContainer Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AetherSuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Real-time monitor for process isolation, capability tokens, Job Object resource quotas, and security audit logs." FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Content="🔄 Refresh Status" Click="RefreshBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8,14,8" CornerRadius="6" />
                </StackPanel>
            </Grid>

            <!-- ══════ AppContainer Sandbox Status Card ══════ -->
            <Grid RowSpacing="16" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Box 1: Process Boundary -->
                <Border Grid.Column="0" Style="{StaticResource AetherMetricCard}" Padding="18">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="20" Foreground="{StaticResource AetherSuccessBrush}" />
                            <TextBlock Text="AppContainer Process Isolation" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="AppContainerText" Text="ACTIVE (Low Integrity Level Enforcement)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AetherSuccessBrush}" />
                        <TextBlock x:Name="IntegrityText" Text="SID: S-1-16-4096 (Win32 AppContainer Token)" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                </Border>

                <!-- Box 2: Job Object Limits -->
                <Border Grid.Column="1" Style="{StaticResource AetherMetricCard}" Padding="18">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{StaticResource AetherAccentBrush}" />
                            <TextBlock Text="Job Object Resource Limits" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="JobLimitsText" Text="RAM Limit: 256 MB per widget | CPU Quota: 15% max" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AetherAccentBrush}" />
                        <TextBlock Text="Hardware Telemetry: Read-Only Shared Telemetry Cache" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Sandbox Operational" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- ══════ Capability Tokens Table ══════ -->
            <TextBlock Text="Active Capability Manifest Tokens" Style="{StaticResource AetherSectionHeader}" />

            <ListView x:Name="CapabilityList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Margin="0,0,0,8" Padding="16,12,16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8D7;" FontSize="22" Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" FontFamily="Consolas" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CategoryText}" FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AuditInfo}" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4,10,4" Background="{StaticResource AetherAccentBrush}" Opacity="0.15" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RiskLevel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AetherAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ══════ Audit Log Stream ══════ -->
            <TextBlock Text="Security Audit Log Stream" Style="{StaticResource AetherSectionHeader}" />

            <ListView x:Name="AuditList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Margin="0,0,0,6" Padding="14,10,14,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AetherTextDimBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Subsystem}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" CornerRadius="3" Padding="6,2,6,2" Background="{StaticResource AetherSuccessBrush}" Opacity="0.15" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Decision}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AetherSuccessBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Target}" FontSize="12" Foreground="{StaticResource AetherTextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding SignatureStatus}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AetherTextDimBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
