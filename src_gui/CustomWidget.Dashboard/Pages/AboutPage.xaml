<Page
    x:Class="CustomWidget.Dashboard.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AetherPagePadding}">
        <StackPanel Spacing="24" MaxWidth="800">

            <!-- ══════ Header Card ══════ -->
            <Border Style="{StaticResource AetherMetricCard}" Background="{StaticResource AetherAccentMutedBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE945;" FontSize="48" Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Aether Studio" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                <Border Background="{StaticResource AetherAccentBrush}" CornerRadius="12" Padding="10,2,10,2" VerticalAlignment="Center">
                                    <TextBlock Text="Phase 15 RC" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Next-Gen Windows Desktop Customization Platform" FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Aether is engineered as a decoupled, multi-process desktop customization engine combining a Rust core daemon (10ms async tick loop, zero-copy telemetry, DirectComposition hardware rendering) with a WinUI 3 management dashboard."
                               FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Quick Links -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="GitHub Repository" Command="{x:Bind ViewModel.OpenGithubCommand}" Style="{StaticResource AccentButtonStyle}">
                            <Button.Icon>
                                <FontIcon Glyph="&#xE71B;" />
                            </Button.Icon>
                        </Button>
                        <Button Content="Documentation" Command="{x:Bind ViewModel.OpenDocsCommand}">
                            <Button.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </Button.Icon>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════ Authors & Credits ══════ -->
            <TextBlock Text="Authors &amp; Credits" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{StaticResource AetherAccentBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Development Team" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AuthorsText}" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Core Architecture:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Rust Async Daemon (tokio, windows-rs, DirectComposition, GDI)" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Management GUI:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="WinUI 3 (Windows App SDK 1.5, C# .NET 8, CommunityToolkit.Mvvm)" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IPC Pipeline:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Win32 Async Named Pipes (\\.\pipe\CustomWidgetEngineControlPipe)" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════ Specifications & Metadata ══════ -->
            <TextBlock Text="System Specifications" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <Grid ColumnSpacing="24" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Dashboard Version" FontSize="13" Foreground="{StaticResource AetherTextDimBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Core Engine Version" FontSize="13" Foreground="{StaticResource AetherTextDimBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.EngineVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Development Phase" FontSize="13" Foreground="{StaticResource AetherTextDimBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PhaseName}" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Target OS" FontSize="13" Foreground="{StaticResource AetherTextDimBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.TargetOS}" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="License" FontSize="13" Foreground="{StaticResource AetherTextDimBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.LicenseName}" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Footer copyright -->
            <TextBlock Text="© 2026 Aether Platform. All rights reserved. Open source under MIT / Apache-2.0 License."
                       FontSize="11" Foreground="{StaticResource AetherTextDimBrush}" HorizontalAlignment="Center" Margin="0,12,0,24" />

        </StackPanel>
    </ScrollViewer>
</Page>
