<Page
    x:Class="CustomWidget.Dashboard.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CustomWidget.Dashboard.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:PercentToColorConverter x:Key="PercentToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AetherPagePadding}">
        <StackPanel Spacing="24">

            <!-- ══════ Header ══════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Overview" FontSize="{StaticResource AetherFontSizeTitle}"
                               FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <TextBlock x:Name="StatusText" Text="Engine Offline"
                               FontSize="{StaticResource AetherFontSizeBody}"
                               Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{StaticResource AetherCardBrush}"
                            CornerRadius="6" Padding="12,6,12,6">
                        <TextBlock x:Name="VersionText" Text="—" FontSize="12"
                                   Foreground="{StaticResource AetherTextDimBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════ Metric Gauges Row ══════ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Gauge -->
                <Border Grid.Column="0" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{StaticResource AetherCpuBrush}" />
                            <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="CpuPctText" Text="0.0%" FontSize="{StaticResource AetherFontSizeHero}"
                                   FontWeight="Bold" Foreground="{StaticResource AetherCpuBrush}" />
                        <ProgressBar x:Name="CpuBar" Value="0" Maximum="100" Height="6"
                                     Foreground="{StaticResource AetherCpuBrush}"
                                     Background="#1AFFFFFF" CornerRadius="3" />
                    </StackPanel>
                </Border>

                <!-- GPU Gauge -->
                <Border Grid.Column="1" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource AetherGpuBrush}" />
                            <TextBlock Text="GPU" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="GpuPctText" Text="0.0%" FontSize="{StaticResource AetherFontSizeHero}"
                                   FontWeight="Bold" Foreground="{StaticResource AetherGpuBrush}" />
                        <ProgressBar x:Name="GpuBar" Value="0" Maximum="100" Height="6"
                                     Foreground="{StaticResource AetherGpuBrush}"
                                     Background="#1AFFFFFF" CornerRadius="3" />
                    </StackPanel>
                </Border>

                <!-- RAM Gauge -->
                <Border Grid.Column="2" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEECA;" FontSize="16" Foreground="{StaticResource AetherRamBrush}" />
                            <TextBlock Text="RAM" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="RamText" Text="0 / 0 GB" FontSize="{StaticResource AetherFontSizeDisplay}"
                                   FontWeight="Bold" Foreground="{StaticResource AetherRamBrush}" />
                        <ProgressBar x:Name="RamBar" Value="0" Maximum="100" Height="6"
                                     Foreground="{StaticResource AetherRamBrush}"
                                     Background="#1AFFFFFF" CornerRadius="3" />
                    </StackPanel>
                </Border>

                <!-- Network Gauge -->
                <Border Grid.Column="3" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE839;" FontSize="16" Foreground="{StaticResource AetherNetBrush}" />
                            <TextBlock Text="NET" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NetRecvText" Text="↓ 0 B/s" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{StaticResource AetherNetBrush}" />
                            <TextBlock x:Name="NetSentText" Text="↑ 0 B/s" FontSize="18"
                                       FontWeight="SemiBold" Foreground="#FF8A65" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════ Quick Actions ══════ -->
            <TextBlock Text="Quick Actions" Style="{StaticResource AetherSectionHeader}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="DesktopWidgetBtn" Content="🖥️  Toggle Desktop Overlay Widget"
                        Click="DesktopWidgetBtn_Click" Style="{StaticResource AccentButtonStyle}"
                        Padding="16,10,16,10" CornerRadius="6" />
                <Button x:Name="ReloadBtn" Content="🔄  Reload All"
                        Click="ReloadBtn_Click"
                        Padding="16,10,16,10" CornerRadius="6" />
                <Button x:Name="ThemeBtn" Content="🎨  Toggle Theme"
                        Click="ThemeBtn_Click" Padding="16,10,16,10" CornerRadius="6" />
                <Button x:Name="PingBtn" Content="📡  Ping Engine"
                        Click="PingBtn_Click" Padding="16,10,16,10" CornerRadius="6" />
            </StackPanel>

            <!-- Ping / action result feedback banner -->
            <TextBlock x:Name="PingResultDisplay" Text=""
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource AetherAccentBrush}"
                       Visibility="Collapsed" />

            <!-- ══════ Status Summary ══════ -->
            <TextBlock Text="System Summary" Style="{StaticResource AetherSectionHeader}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Active Widgets" FontSize="12"
                                   Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock x:Name="WidgetCountText" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AetherAccentBrush}" />
                        <TextBlock x:Name="WidgetListText" Text="No active widgets" FontSize="12"
                                   Foreground="{StaticResource AetherTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Subsystem Health" FontSize="12"
                                   Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock x:Name="SubsystemText" Text="—" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AetherSuccessBrush}" />
                        <TextBlock Text="subsystems registered" FontSize="12"
                                   Foreground="{StaticResource AetherTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AetherMetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="IPC Connection" FontSize="12"
                                   Foreground="{StaticResource AetherTextDimBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="IpcDot" Width="12" Height="12"
                                     Fill="{StaticResource AetherErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="IpcText" Text="Disconnected" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="\\.\pipe\CustomWidgetEngineControlPipe" FontSize="10"
                                   Foreground="{StaticResource AetherTextDimBrush}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
