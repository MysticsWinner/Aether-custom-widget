<Page
    x:Class="CustomWidget.Dashboard.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CustomWidget.Dashboard.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:HealthToColorConverter x:Key="HealthToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AetherPagePadding}">
        <StackPanel Spacing="24">

            <!-- ══════ Header ══════ -->
            <TextBlock Text="Services" FontSize="{StaticResource AetherFontSizeTitle}"
                       FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
            <TextBlock Text="Engine lifecycle control and subsystem health monitoring"
                       FontSize="{StaticResource AetherFontSizeBody}"
                       Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- ══════ Engine Control Card ══════ -->
            <Border Style="{StaticResource AetherMetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Aether Core Engine" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="EngineStatusDot" Width="10" Height="10"
                                     Fill="{StaticResource AetherErrorBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineStatusText" Text="Stopped"
                                       FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="EnginePidText" Text="PID: —"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock x:Name="BusyText" Text=""
                                   FontSize="12" Foreground="{StaticResource AetherWarningBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="StartBtn" Content="▶  Start" Click="StartBtn_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,10,16,10" CornerRadius="6" />
                        <Button x:Name="StopBtn" Content="⏹  Stop" Click="StopBtn_Click"
                                Padding="16,10,16,10" CornerRadius="6" />
                        <Button x:Name="RestartBtn" Content="🔄  Restart" Click="RestartBtn_Click"
                                Padding="16,10,16,10" CornerRadius="6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════ Quick Test ══════ -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PingBtn" Content="📡  Ping Engine" Click="PingBtn_Click"
                        Padding="16,10,16,10" CornerRadius="6" />
                <TextBlock x:Name="PingResultText" Text="" FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource AetherTextSecondaryBrush}" />
            </StackPanel>

            <!-- ══════ Subsystem Health Grid ══════ -->
            <TextBlock Text="Subsystem Health" Style="{StaticResource AetherSectionHeader}" />

            <ItemsRepeater x:Name="SubsystemRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Padding="16,12,16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Fill="{Binding Health, Converter={StaticResource HealthToColor}}" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{StaticResource AetherTextDimBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="4" Padding="8,4,8,4" VerticalAlignment="Center"
                                        Background="{Binding Health, Converter={StaticResource HealthToColor}}"
                                        Opacity="0.2">
                                    <TextBlock Text="{Binding Health}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Health, Converter={StaticResource HealthToColor}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Empty state when no subsystems -->
            <TextBlock x:Name="EmptySubsystemText"
                       Text="Engine is not running — start the engine to see subsystem health."
                       FontSize="14" Foreground="{StaticResource AetherTextDimBrush}"
                       FontStyle="Italic" />

        </StackPanel>
    </ScrollViewer>
</Page>
