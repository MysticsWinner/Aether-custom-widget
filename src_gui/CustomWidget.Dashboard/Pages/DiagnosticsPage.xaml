<Page
    x:Class="CustomWidget.Dashboard.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource AetherPagePadding}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════ Header + Controls ══════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Diagnostics Hub" FontSize="{StaticResource AetherFontSizeTitle}"
                               FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <!-- Error/Warn count badge -->
                    <Border x:Name="ErrorBadge" CornerRadius="10" Padding="8,2,8,2"
                            Background="{StaticResource AetherErrorBrush}" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorBadgeText" Text="0" FontSize="11" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Browse log files, view project-wide diagnostic outputs, and send raw IPC control commands."
                           FontSize="{StaticResource AetherFontSizeBody}"
                           Foreground="{StaticResource AetherTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ══════ Browsable Files & Logs Panel ══════ -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: File Browser -->
            <Border Grid.Column="0" Style="{StaticResource AetherMetricCard}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Browsable Logs" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource AetherTextPrimaryBrush}" />

                    <ListView x:Name="LogFilesList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="LogFilesList_SelectionChanged"
                              Margin="0,8,0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4,0,4">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{StaticResource AetherAccentBrush}" />
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button Content="📂 Open Folder location" Click="OpenFolderBtn_Click" 
                                HorizontalAlignment="Stretch" Padding="12,8,12,8" CornerRadius="4" />
                        <Button Content="🔄 Refresh List" Click="RefreshFilesBtn_Click" 
                                HorizontalAlignment="Stretch" Padding="12,8,12,8" CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Live Log Viewer -->
            <Border Grid.Column="1" Style="{StaticResource AetherMetricCard}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedLogTitle" Text="Recent Logs (None Selected)" 
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="LevelFilter" Width="110" SelectedIndex="0" 
                                      SelectionChanged="LevelFilter_SelectionChanged">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="TRACE" />
                                <ComboBoxItem Content="DEBUG" />
                                <ComboBoxItem Content="INFO" />
                                <ComboBoxItem Content="WARN" />
                                <ComboBoxItem Content="ERROR" />
                            </ComboBox>
                            <Button Content="📋 Copy" Click="CopyLogBtn_Click" Padding="10,6,10,6" CornerRadius="4" />
                            <Button Content="🗑️ Clear File" Click="ClearLogFileBtn_Click" Padding="10,6,10,6" CornerRadius="4" />
                        </StackPanel>
                    </Grid>

                    <!-- Text Viewer for selected Log File -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" 
                                  Background="#141522" CornerRadius="4" Padding="10">
                        <TextBox x:Name="LogContentBox" IsReadOnly="True" AcceptsReturn="True" 
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent" 
                                 Foreground="#ECECEC" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" x:Name="LogStatusText" Text="Select a log file to view recent diagnostics." 
                               FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ══════ IPC Console ══════ -->
        <Border Grid.Row="2" Style="{StaticResource AetherMetricCard}">
            <StackPanel Spacing="12">
                <TextBlock Text="IPC Command Console" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource AetherTextPrimaryBrush}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CommandInput" Grid.Column="0"
                             PlaceholderText='e.g. "GetStatus" or {"LoadWidget":{"manifest_path":"..."}}'
                             Text='"GetStatus"'
                             FontFamily="Cascadia Code,Consolas" FontSize="13"
                             AcceptsReturn="False" />

                    <Button Grid.Column="1" Content="Send" Click="SendBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="20,8,20,8" CornerRadius="4" />
                </Grid>

                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseOutput" Text="" FontFamily="Cascadia Code,Consolas"
                               FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
