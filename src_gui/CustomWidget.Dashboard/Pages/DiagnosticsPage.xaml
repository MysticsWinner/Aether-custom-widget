<Page
    x:Class="CustomWidget.Dashboard.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CustomWidget.Dashboard.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColor" />
    </Page.Resources>

    <Grid Padding="{StaticResource AetherPagePadding}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════ Header + Controls ══════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Diagnostics" FontSize="{StaticResource AetherFontSizeTitle}"
                               FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <!-- Error/Warn count badge -->
                    <Border x:Name="ErrorBadge" CornerRadius="10" Padding="8,2,8,2"
                            Background="{StaticResource AetherErrorBrush}" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorBadgeText" Text="0" FontSize="11" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Live engine logs, IPC command console, and error inspector"
                           FontSize="{StaticResource AetherFontSizeBody}"
                           Foreground="{StaticResource AetherTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="LevelFilter" Width="120" PlaceholderText="Level"
                          SelectedIndex="0" SelectionChanged="LevelFilter_SelectionChanged">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="TRACE" />
                    <ComboBoxItem Content="DEBUG" />
                    <ComboBoxItem Content="INFO" />
                    <ComboBoxItem Content="WARN" />
                    <ComboBoxItem Content="ERROR" />
                </ComboBox>
                <Button Content="Clear" Click="ClearBtn_Click" Padding="12,8,12,8" CornerRadius="4" />
            </StackPanel>
        </Grid>

        <!-- ══════ Log Viewer ══════ -->
        <Border Grid.Row="1" Style="{StaticResource AetherMetricCard}" Padding="0">
            <ListView x:Name="LogListView" SelectionMode="None"
                      Padding="12,8,12,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,3,4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="11" FontFamily="Cascadia Code,Consolas"
                                       Foreground="{StaticResource AetherTextDimBrush}"
                                       Text="{Binding Timestamp, Converter={x:Null}}" />

                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold"
                                       FontFamily="Cascadia Code,Consolas"
                                       Text="{Binding Level}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" />

                            <TextBlock Grid.Column="2" FontSize="11" FontFamily="Cascadia Code,Consolas"
                                       Foreground="{StaticResource AetherTextSecondaryBrush}"
                                       Text="{Binding Target}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Cascadia Code,Consolas"
                                       Foreground="{StaticResource AetherTextPrimaryBrush}"
                                       Text="{Binding Message}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ══════ IPC Console ══════ -->
        <Border Grid.Row="2" Style="{StaticResource AetherMetricCard}">
            <StackPanel Spacing="12">
                <TextBlock Text="IPC Command Console" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource AetherTextPrimaryBrush}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CommandInput" Grid.Column="0"
                             PlaceholderText='e.g. "GetStatus" or {"LoadWidget":{"manifest_path":"..."}}'
                             Text='"GetStatus"'
                             FontFamily="Cascadia Code,Consolas" FontSize="13"
                             AcceptsReturn="False" />

                    <Button Grid.Column="1" Content="Send" Click="SendBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="20,8,20,8" CornerRadius="4" />
                </Grid>

                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseOutput" Text="" FontFamily="Cascadia Code,Consolas"
                               FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
