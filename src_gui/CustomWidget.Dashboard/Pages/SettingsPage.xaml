<Page
    x:Class="CustomWidget.Dashboard.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AetherPagePadding}">
        <StackPanel Spacing="24" MaxWidth="800">

            <!-- ══════ Header ══════ -->
            <TextBlock Text="Settings" FontSize="{StaticResource AetherFontSizeTitle}"
                       FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />

            <!-- ══════ Appearance Section ══════ -->
            <TextBlock Text="Appearance" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Theme Mode" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <TextBlock Text="Controls the dashboard and engine visual theme"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="140"
                              SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="System" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ══════ Telemetry Section ══════ -->
            <TextBlock Text="Telemetry" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Polling Interval" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource AetherTextPrimaryBrush}" />
                            <TextBlock Text="How often the dashboard polls the engine for telemetry data"
                                       FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="IntervalText" Grid.Column="1" Text="500 ms" FontSize="14"
                                   Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="IntervalSlider" Minimum="100" Maximum="2000"
                            StepFrequency="100" Value="500"
                            ValueChanged="IntervalSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- ══════ Engine Section ══════ -->
            <TextBlock Text="Engine" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Auto-start Engine" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <TextBlock Text="Automatically start the core engine when the dashboard launches"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1"
                                  IsOn="False" Toggled="AutoStartToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ══════ Cloud Sync Section ══════ -->
            <TextBlock Text="Cloud Sync" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Enable Cloud Sync" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <TextBlock Text="CRDT-based encrypted sync across devices (AES-256-GCM)"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloudSyncToggle" Grid.Column="1"
                                  IsOn="False" Toggled="CloudSyncToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ══════ AI Features Section ══════ -->
            <TextBlock Text="AI Features" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Enable AI Intelligence" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <TextBlock Text="AI-powered layout synthesis, theme generation, and voice commands"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AiToggle" Grid.Column="1"
                                  IsOn="False" Toggled="AiToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ══════ About Section ══════ -->
            <TextBlock Text="About" Style="{StaticResource AetherSectionHeader}" />

            <Border Style="{StaticResource AetherMetricCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE945;" FontSize="32" Foreground="{StaticResource AetherAccentBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Aether Studio" FontWeight="Bold" FontSize="18"
                                       Foreground="{StaticResource AetherTextPrimaryBrush}" />
                            <TextBlock Text="Next-Gen Windows Desktop Customization Platform"
                                       FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dashboard Version"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="0.5.0"
                                   FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Engine Version"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock x:Name="EngineVersionText" Grid.Row="1" Grid.Column="1" Text="—"
                                   FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phase"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="15 — Production Release Candidate"
                                   FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Target"
                                   FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Windows 11 (x64 / ARM64)"
                                   FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                    </Grid>

                    <!-- Reset button -->
                    <Button x:Name="ResetBtn" Content="Reset All Settings to Defaults"
                            Click="ResetBtn_Click" Padding="16,8,16,8" CornerRadius="4"
                            Margin="0,8,0,0" />

                    <!-- Status message -->
                    <TextBlock x:Name="StatusText" Text="" FontSize="12"
                               Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
