<Page
    x:Class="CustomWidget.Dashboard.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20">
            <!-- Header Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Desktop Profiles Manager" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <TextBlock Text="Switch between activity profiles or configure context-aware auto-triggers." FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="RefreshBtn" Grid.Column="1" Content="🔄 Refresh Profiles" Click="RefreshBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8,14,8" CornerRadius="6" VerticalAlignment="Center" />
            </Grid>

            <!-- Status message -->
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- Profiles ListView -->
            <ListView x:Name="ProfilesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Margin="0,0,0,12" Padding="18,16,18,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="28" Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />

                                <!-- Profile details -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <Border CornerRadius="4" Padding="6,2,6,2" Background="{StaticResource AetherAccentBrush}" Opacity="0.15">
                                            <TextBlock Text="{Binding Id}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AetherAccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SpecsText}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AetherAccentBrush}" />
                                </StackPanel>

                                <!-- Action Button -->
                                <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding}" Click="ActivateProfile_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8,16,8" CornerRadius="6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
