<Page
    x:Class="CustomWidget.Dashboard.Pages.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AetherPagePadding}">
        <StackPanel Spacing="24">

            <!-- ══════ Header ══════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Widgets" FontSize="{StaticResource AetherFontSizeTitle}"
                               FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <TextBlock Text="Manage installed widgets — load, unload, and configure"
                               FontSize="{StaticResource AetherFontSizeBody}"
                               Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DesktopWidgetBtn" Content="🖥️  Toggle Desktop Overlay Widget" Click="DesktopWidgetBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,10,16,10" CornerRadius="6" />
                    <Button x:Name="LoadBtn" Content="📂  Load Widget" Click="LoadBtn_Click"
                            Padding="16,10,16,10" CornerRadius="6" />
                    <Button x:Name="ReloadBtn" Content="🔄  Reload All" Click="ReloadBtn_Click"
                            Padding="16,10,16,10" CornerRadius="6" />
                </StackPanel>
            </Grid>

            <!-- ══════ Status Message ══════ -->
            <TextBlock x:Name="StatusText" Text="" FontSize="13"
                       Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- ══════ Widget List ══════ -->
            <ListView x:Name="WidgetList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Margin="0,0,0,8" Padding="16,14,16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Widget icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="24"
                                          Foreground="{StaticResource AetherAccentBrush}"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />

                                <!-- Widget info -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Id}" FontSize="12"
                                               Foreground="{StaticResource AetherTextDimBrush}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>

                                <!-- State badge -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4,10,4"
                                        Background="{StaticResource AetherSuccessBrush}" Opacity="0.15"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AetherSuccessBrush}" />
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="🔒 Lock/Unlock" Tag="{Binding Id}" Click="LockBtn_Click"
                                            Padding="10,6,10,6" CornerRadius="4" ToolTipService.ToolTip="Toggle drag lock state for this widget" />
                                    <Button Content="📍 Reset Pos" Tag="{Binding Id}" Click="ResetPosBtn_Click"
                                            Padding="10,6,10,6" CornerRadius="4" ToolTipService.ToolTip="Reset widget screen position to default (100, 100)" />
                                    <Button Content="Unload" Tag="{Binding Id}" Click="UnloadBtn_Click"
                                            Padding="12,6,12,6" CornerRadius="4" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ══════ Empty State ══════ -->
            <StackPanel x:Name="EmptyState" Spacing="12" HorizontalAlignment="Center" Padding="0,40,0,40">
                <FontIcon Glyph="&#xE74C;" FontSize="48" Foreground="{StaticResource AetherTextDimBrush}" />
                <TextBlock Text="No widgets loaded" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource AetherTextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Load a widget manifest (.toml) or start the engine to see built-in widgets."
                           FontSize="13" Foreground="{StaticResource AetherTextDimBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
