<Page
    x:Class="CustomWidget.Dashboard.Pages.DesignTokensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Design Tokens Inspector" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <TextBlock Text="Inspect and customize Aether 7.4 12-category semantic design token hierarchy." FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="ResolveBtn" Grid.Column="1" Content="🔄 Resolve Tokens" Click="ResolveBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8,14,8" CornerRadius="6" VerticalAlignment="Center" />
            </Grid>

            <!-- Active Token Set & Accent Palette Card -->
            <Border Style="{StaticResource AetherMetricCard}" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Active Accent Palette &amp; Dynamic Extraction" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource AetherAccentBrush}" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="AccentText" Text="Windows 11 System Accent: #0078D7" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                            <TextBlock x:Name="StatusBadge" Text="WCAG 2.1 AA Contrast Ratio: 7.2:1 (Passes High Contrast Threshold)" FontSize="12" Foreground="{StaticResource AetherSuccessBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="{StaticResource AetherTextDimBrush}" />
                </StackPanel>
            </Border>

            <!-- 12 Token Categories Grid -->
            <Grid RowSpacing="16" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Colors Token Category -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AetherMetricCard}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Colors Category" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <ListView x:Name="ColorTokensList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource AetherTextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Typography Token Category -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AetherMetricCard}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Typography Category" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <ListView x:Name="TypographyTokensList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource AetherTextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Materials & Surfaces Category -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AetherMetricCard}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Materials &amp; Surfaces Category" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <ListView x:Name="MaterialTokensList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource AetherTextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Motion & Accessibility Category -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AetherMetricCard}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Motion &amp; Accessibility Category" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                        <ListView x:Name="MotionTokensList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource AetherTextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
