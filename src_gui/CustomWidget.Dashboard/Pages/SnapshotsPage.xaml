<Page
    x:Class="CustomWidget.Dashboard.Pages.SnapshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20">

            <!-- ══════ Header Bar ══════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Snapshots &amp; Recovery Hub" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <TextBlock Text="Transactional system configuration backups, 1-click snapshot restores, and export/import functionality." FontSize="14" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Content="🔄 Refresh List" Click="RefreshBtn_Click" Padding="14,8,14,8" CornerRadius="6" />
                </StackPanel>
            </Grid>

            <!-- ══════ Create Snapshot Card ══════ -->
            <Border Style="{StaticResource AetherMetricCard}" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Create New Configuration Snapshot" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NameInput" Grid.Column="0" PlaceholderText="Snapshot name (e.g. 'Post-Update Baseline')..." />
                        <Button Grid.Column="1" Content="📸 Take Snapshot" Click="CreateBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8,16,8" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="13" Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- ══════ Snapshots List ══════ -->
            <TextBlock Text="Saved System Snapshots" Style="{StaticResource AetherSectionHeader}" />

            <ListView x:Name="SnapshotsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AetherMetricCard}" Margin="0,0,0,10" Padding="18,14,18,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Snapshot Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="28" Foreground="{StaticResource AetherAccentBrush}" VerticalAlignment="Center" />

                                <!-- Details -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AetherTextPrimaryBrush}" />
                                        <Border CornerRadius="4" Padding="6,2,6,2" Background="{StaticResource AetherAccentBrush}" Opacity="0.15">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AetherAccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ScopeText}" FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CreatedAtText}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AetherTextDimBrush}" />
                                </StackPanel>

                                <!-- Widget Count Badge -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4,10,4" Background="{StaticResource AetherSuccessBrush}" Opacity="0.15" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WidgetCountText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AetherSuccessBrush}" />
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="⚡ Restore Snapshot" Tag="{Binding}" Click="RestoreBtn_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,6,14,6" CornerRadius="6" />
                                    <Button Content="🗑️ Delete" Tag="{Binding}" Click="DeleteBtn_Click" Padding="12,6,12,6" CornerRadius="6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
