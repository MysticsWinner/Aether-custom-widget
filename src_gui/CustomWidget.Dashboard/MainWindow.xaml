<Window
    x:Class="CustomWidget.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aether Studio">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Connection status bar (top) ── -->
        <InfoBar Grid.Row="0"
                 x:Name="ConnectionInfoBar"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Engine Offline"
                 Message="The Aether core engine is not running. Start it from Services or run 'cargo run -p core_engine'."
                 Margin="0,0,0,0" />

        <!-- ── Main NavigationView ── -->
        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        IsPaneOpen="True"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded"
                        Margin="0,0,0,0">

            <!-- ── Navigation Header ── -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Padding="12,16,12,8" Spacing="10">
                    <SymbolIcon Symbol="Home" Foreground="{StaticResource AetherAccentBrush}" />
                    <TextBlock Text="Aether Studio"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AetherTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- ── Navigation Items ── -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavOverview" Tag="Overview" Content="Overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavTokens" Tag="Tokens" Content="Design Tokens">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="FontColor" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavProfiles" Tag="Profiles" Content="Desktop Profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Account" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAiComposer" Tag="AiComposer" Content="AI Composer">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWidgets" Tag="Widgets" Content="Widgets">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavMarketplace" Tag="Marketplace" Content="Marketplace">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSnapshots" Tag="Snapshots" Content="Snapshots &amp; Recovery">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSecurity" Tag="Security" Content="Security &amp; Sandbox">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Permissions" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavServices" Tag="Services" Content="Services">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Admin" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPerformance" Tag="Performance" Content="Performance">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavDiagnostics" Tag="Diagnostics" Content="Diagnostics">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem x:Name="NavSettings" Tag="Settings" Content="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAbout" Tag="About" Content="About">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- ── Footer: IPC connection status ── -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,8,16,12" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="IpcStatusDot" Width="8" Height="8"
                                 Fill="{StaticResource AetherErrorBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="IpcStatusText" Text="Disconnected"
                                   FontSize="12" Foreground="{StaticResource AetherTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="EngineVersionText" Text=""
                               FontSize="10" Foreground="{StaticResource AetherTextDimBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- ── Page Content ── -->
            <Frame x:Name="ContentFrame" Padding="0" />
        </NavigationView>
    </Grid>
</Window>
