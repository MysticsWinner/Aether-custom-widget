<Application
    x:Class="CustomWidget.Dashboard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Primary Accent -->
            <SolidColorBrush x:Key="AetherAccentBrush" Color="#00B4FF" />

            <!-- Surface / Background -->
            <SolidColorBrush x:Key="AetherSurfaceBrush" Color="#1A1C2E" />
            <SolidColorBrush x:Key="AetherCardBrush" Color="#22243A" />
            <SolidColorBrush x:Key="AetherCardHoverBrush" Color="#2A2D48" />

            <!-- Semantic Colors -->
            <SolidColorBrush x:Key="AetherSuccessBrush" Color="#00E676" />
            <SolidColorBrush x:Key="AetherWarningBrush" Color="#FFB300" />
            <SolidColorBrush x:Key="AetherErrorBrush" Color="#FF5252" />

            <!-- Metric-Specific Colors -->
            <SolidColorBrush x:Key="AetherCpuBrush" Color="#00D4FF" />
            <SolidColorBrush x:Key="AetherGpuBrush" Color="#E040FB" />
            <SolidColorBrush x:Key="AetherRamBrush" Color="#69F0AE" />
            <SolidColorBrush x:Key="AetherNetBrush" Color="#FFD740" />

            <!-- Text Colors -->
            <SolidColorBrush x:Key="AetherTextPrimaryBrush" Color="#EAEAEA" />
            <SolidColorBrush x:Key="AetherTextSecondaryBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="AetherTextDimBrush" Color="#616161" />

            <!-- Typography -->
            <x:Double x:Key="AetherFontSizeCaption">12</x:Double>
            <x:Double x:Key="AetherFontSizeBody">14</x:Double>
            <x:Double x:Key="AetherFontSizeSubtitle">18</x:Double>
            <x:Double x:Key="AetherFontSizeTitle">24</x:Double>
            <x:Double x:Key="AetherFontSizeDisplay">36</x:Double>
            <x:Double x:Key="AetherFontSizeHero">48</x:Double>

            <!-- Spacing & Layout -->
            <Thickness x:Key="AetherPagePadding">36,24,36,24</Thickness>
            <Thickness x:Key="AetherCardPadding">20,16,20,16</Thickness>
            <Thickness x:Key="AetherItemSpacing">0,0,0,12</Thickness>
            <CornerRadius x:Key="AetherCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AetherBadgeCornerRadius">4</CornerRadius>

            <!-- Metric card style for Overview gauges -->
            <Style x:Key="AetherMetricCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AetherCardBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource AetherCardCornerRadius}" />
                <Setter Property="Padding" Value="{ThemeResource AetherCardPadding}" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Status badge style -->
            <Style x:Key="AetherStatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="{ThemeResource AetherBadgeCornerRadius}" />
                <Setter Property="Padding" Value="8,4,8,4" />
            </Style>

            <!-- Section header text -->
            <Style x:Key="AetherSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AetherFontSizeSubtitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AetherTextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,24,0,12" />
            </Style>

            <!-- Dim caption text -->
            <Style x:Key="AetherCaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AetherFontSizeCaption}" />
                <Setter Property="Foreground" Value="{ThemeResource AetherTextDimBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
